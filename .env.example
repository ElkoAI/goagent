# GoAgent gateway configuration
GOAGENT_TOKEN=your-secret-token-here
BRAVE_SEARCH_API_KEY=your-brave-api-key-here

# Search backend: "brave" or "duckduckgo" (auto-detects if unset)
SEARCH_BACKEND=duckduckgo

# LLM configuration (OpenAI-compatible API)
# Works with any OpenAI-compatible provider. See LLM-OPTIONS.md for full list.
#
# --- DeepSeek (default, paid) ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your-deepseek-key
# LLM_MODEL=deepseek-chat
#
# --- Groq (free, recommended for dev) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your-groq-key
# LLM_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
#
# --- Ollama (local) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:14b
